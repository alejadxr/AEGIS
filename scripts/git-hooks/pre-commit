#!/usr/bin/env bash
# AEGIS pre-commit secret guard.
#
# This repo is public. It has already leaked a sudo password (2 months, 7 forks)
# and ~820 lines of unrelated private projects, both because a .gitignore rule
# was written but never enforced against the index. A rule nobody runs is not a
# control; this hook is the enforcement.
#
# Install:  git config core.hooksPath scripts/git-hooks
# Bypass:   git commit --no-verify   (only when you have actually checked)
#
# NOTE ON STYLE: findings are accumulated with command substitution, never via
# `grep ... | while read`. A while loop on the right of a pipe runs in a
# SUBSHELL, so any flag it sets is discarded when the subshell exits — the
# first version of this hook printed its findings and then exited 0, detecting
# everything and blocking nothing.
set -uo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

findings=""

CRED_RE='(echo[[:space:]]+[0-9]{4,}[[:space:]]*\||sshpass|BEGIN [A-Z ]*PRIVATE KEY|(password|passwd|secret|api[_-]?key|token)[[:space:]]*[:=][[:space:]]*['"'"'"][^'"'"'"]{8,}['"'"'"])'
INFRA_RE='/Users/(alejandxr)|/home/diego|somoswilab\.com|100\.(8[0-9]|9[0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}'
# Well-known PUBLIC addresses that legitimately appear in detection rules and
# IOC lists. 169.254.169.254 is the cloud metadata endpoint; 100.100.100.200 is
# Alibaba's, which falls numerically inside Tailscale's 100.64.0.0/10 CGNAT
# block and therefore trips the infra regex. Blocking those would mean this
# repo could never carry an SSRF rule — the guard has to know the difference
# between "our network" and "an indicator of compromise".
ALLOW_RE='example|placeholder|your_|<USER>|<user>|xxx|dummy|getenv|environ|process\.env|\$\{|CHANGELOG|169\.254\.169\.254|100\.100\.100\.200|metadata\.google\.internal'

for f in $staged; do
  [ -f "$f" ] || continue
  case "$f" in scripts/git-hooks/*|CHANGELOG.md) continue;; esac
  content=$(git show ":$f" 2>/dev/null) || continue

  hit=$(printf '%s' "$content" | grep -nIE "$CRED_RE" 2>/dev/null | grep -viE "$ALLOW_RE" | head -2)
  [ -n "$hit" ] && findings+="  SECRETO  $f"$'\n'"$hit"$'\n'

  hit=$(printf '%s' "$content" | grep -nIE "$INFRA_RE" 2>/dev/null | grep -viE "$ALLOW_RE" | head -2)
  [ -n "$hit" ] && findings+="  INFRA    $f"$'\n'"$hit"$'\n'
done

priv=$(printf '%s\n' "$staged" | grep -E '^pi-deploy/(sid-backend|wilabia-backend|landing-wilab|sable)/|^docs/superpowers/|^investigations/|^\.agents/|^deploy\.(py|sh)$' || true)
[ -n "$priv" ] && findings+="  PRIVADO  otro proyecto / doc interno:"$'\n'"$priv"$'\n'

if [ -n "$findings" ]; then
  printf '\n\033[31mCOMMIT BLOQUEADO\033[0m — este repo es publico.\n\n%s\n' "$findings"
  echo "Corrige lo anterior, o 'git commit --no-verify' si ya lo verificaste."
  exit 1
fi
exit 0
