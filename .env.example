# AEGIS Autonomous Defense Platform
# Copy to .env and fill in values
# For Docker deployment, most defaults work out of the box.

# Core
AEGIS_ENV=production
# Both are REQUIRED: docker compose refuses to start without them.
# Generate the key with: openssl rand -hex 32
AEGIS_SECRET_KEY=change-me-to-random-string
# Password of the first admin account (the login is admin@aegis.local).
AEGIS_ADMIN_PASSWORD=change-me-to-a-strong-password
AEGIS_API_PORT=8000

# AI Provider (set one)
# OpenRouter (recommended - free models available)
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# For OpenAI: set BASE_URL=https://api.openai.com/v1
# For Ollama: set BASE_URL=http://host.docker.internal:11434/v1, KEY=ollama

# Database (Docker-managed PostgreSQL)
POSTGRES_HOST=aegis-db
POSTGRES_PORT=5432
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-to-random-string
DATABASE_URL=postgresql+asyncpg://aegis:change-me-to-random-string@aegis-db:5432/aegis

# Event Bus
USE_MEMORY_BUS=true
REDIS_URL=redis://aegis-redis:6379

# Scanning tools (paths inside container)
NUCLEI_PATH=nuclei
NMAP_PATH=/usr/bin/nmap
SUBFINDER_PATH=subfinder
HTTPX_PATH=httpx

# Notifications (optional)
WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Firewall enforcement (REQUIRED for docker compose)
# The Compose stack includes the firewall agent (service aegis-firewall),
# which applies AEGIS's blocks to THIS machine's iptables. No extra hardware.
# The API and the agent authenticate each other with this shared secret
# (header X-AEGIS-FW-Auth). Generate it with: openssl rand -hex 32
AEGIS_FIREWALL_SECRET=
# Addresses the firewall must never block, on top of the private, VPN and
# loopback ranges it always spares. Add your own public IP here.
AEGIS_SAFE_IPS=
# Optional: enforce on a separate gateway instead (for example a Raspberry Pi
# in front of the server running firewall-agent/ under systemd, with the same
# secret). Set its URL here and stop the in-stack agent:
#   docker compose stop aegis-firewall
# AEGIS_FIREWALL_URL=http://<gateway>:8765

# Node app <-> backend shared secret for unauthenticated node-facing
# endpoints (/nodes/heartbeat, /nodes/announce, /nodes/status/{code},
# /nodes/events, /nodes/report-assets), sent as header X-AEGIS-Node-Auth.
# EndpointAgent has no per-node secret field yet, so this is a single
# shared secret for all nodes. If unset, these endpoints accept requests
# unauthenticated (compat mode) exactly as before this variable existed.
AEGIS_NODE_SECRET=
